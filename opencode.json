{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "owner": {
      "model": "omniroute/combo-owner",
      "temperature": 0.3
    },
    "designer": {
      "model": "omniroute/combo-designer",
      "temperature": 0.3,
      "permission": {
        "pencil_*": "allow"
      }
    },
    "coder": {
      "model": "omniroute/combo-coder",
      "temperature": 0.0
    },
    "reviewer": {
      "model": "omniroute/combo-reviewer",
      "temperature": 0.1
    }
  },
  "instructions": ["AGENTS.md"]
}
