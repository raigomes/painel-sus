{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omniroute_local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute Local",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "omniroute-token-local"
      }
    }
  },
  "agent": {
    "owner": {
      "model": "omniroute_local/combo-owner",
      "temperature": 0.3,
      "maxTokens": 8192,
      "description": "Gerente de Projeto e Orquestrador"
    },
    "designer": {
      "model": "omniroute_local/combo-designer",
      "temperature": 0.3,
      "maxTokens": 8192,
      "description": "Arquiteto UI/UX e Pencil.dev"
    },
    "coder": {
      "model": "omniroute_local/combo-coder",
      "temperature": 0.0,
      "maxTokens": 8192,
      "description": "Engenheiro de Software Focado em Código"
    },
    "reviewer": {
      "model": "omniroute_local/combo-reviewer",
      "temperature": 0.1,
      "maxTokens": 8192,
      "description": "Auditor de Qualidade e Segurança"
    }
  },
  "instructions": ["AGENTS.md"]
}
