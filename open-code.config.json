{
  "$schema": "https://opencode.dev/config.json",
  "provider": {
    "omniroute_local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute Local",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "omniroute-token-local"
      }
    }
  },
  "agent": {
    "owner": {
      "model": "omniroute_local/combo-owner",
      "temperature": 0.3,
      "maxTokens": 8192
    },
    "designer": {
      "model": "omniroute_local/combo-designer",
      "temperature": 0.3,
      "maxTokens": 8192
    },
    "coder": {
      "model": "omniroute_local/combo-coder",
      "temperature": 0.0,
      "maxTokens": 8192
    },
    "reviewer": {
      "model": "omniroute_local/combo-reviewer",
      "temperature": 0.1,
      "maxTokens": 8192
    }
  }
}
